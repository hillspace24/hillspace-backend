PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/hillspace
FRONTEND_URL=http://localhost:3000
# Public API origin used in email links (include host only; /api is added automatically)
# On Render this falls back to RENDER_EXTERNAL_URL if unset.
# BACKEND_URL=https://hillspace-backend.onrender.com
# Public logo shown at the top of transactional emails (https required)
# EMAIL_LOGO_URL=https://res.cloudinary.com/ar0uptfy/image/upload/f_png,w_240,c_fit,q_auto/hillspace/email-logo.png

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=hillspace

# Email — Brevo transactional API (https://app.brevo.com/settings/keys/api)
# Sender must be verified in Brevo (Senders & IPs). Skip boot check: EMAIL_VERIFY_ON_BOOT=false
BREVO_API_KEY=
BREVO_SENDER_NAME=HillSpace
BREVO_SENDER_EMAIL=hillspace24@gmail.com

# Or combined: BREVO_FROM=HillSpace <hello@yourdomain.com>
# Optional: add waitlist signups to a Brevo contact list (Contacts > Lists)
# BREVO_WAITLIST_LIST_ID=2
